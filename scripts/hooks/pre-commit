#!/usr/bin/env python3
"""Git pre-commit hook for Seisa. Enable once per clone (hooks in .git/hooks are not versioned, this directory is):

    git config core.hooksPath scripts/hooks

What it checks, always on what is STAGED (the index), not on the working tree:

  1. Forbidden files: CLAUDE.md, .env, data/, logs/, tests/private/, reports/ (except .gitkeep). They are gitignored,
     so this only catches `git add -f`.
  2. No long dash (U+2014) in added lines (all files except frontend/vendor/, which is third-party code).
  3. Language pairs: a document and its twin (DOC_PAIRS in scripts/check_docs.py, for example README.md <->
     README.pl.md or docs/X.md <-> docs/pl/X.md) must be staged together. `SEISA_ONE_LANG=1 git commit ...` skips ONLY
     this rule (a typo fixed in one language); everything else still runs, scripts/check_docs.py included.
  4. scripts/check_i18n.py --strict and scripts/check_docs.py, run on an export of the index: catalogs, the same
     version in all four places, and the documentation (pairs, headings, links, agreement with the code).
  5. Version step: if the version differs from the one on `main`, the difference must be exactly one allowed step:
     Z+1, or Y+1 with Z=0, or X+1 with Y=Z=0. A branch therefore cannot bump twice. `main` is the newest of the
     merge-bases with main, origin/main and github/main, so a local `main` that was not updated does not count. A bump must come
     together with its release notes: a `## X.Y.Z - YYYY-MM-DD` entry in CHANGELOG.md whose date is the one in
     <meta name="seisa-release-date"> of frontend/index.html.
  6. Privacy scan of added lines: no API-key-looking strings, no home directory paths (/Users/name/, /home/name/) and none
     of your own host or domain names. The names live in a file OUTSIDE the repository, one per line (`#` comments;
     a line starting with `!` is a string that is allowed, for example the author's public contact data, and is
     removed before scanning): ~/.config/seisa/privacy-markers.txt, or the file named by SEISA_PRIVACY_MARKERS. Without
     the file only the generic checks run and a note says so. The offending value is never printed.

`pre-commit --commit-msg FILE` (called by the commit-msg hook next to this file) checks the commit message: no long
dash, no Co-Authored-By trailer and no "Generated with Claude Code" footer (docs/DEVELOPMENT.md), and the same
privacy scan.

`pre-commit --range BASE` (used by CI on pull requests, also runnable by hand) checks the whole branch instead of
one commit: when PROGRAM files changed since the merge-base with BASE the version must have gone up by one allowed
step, and when none did it must be unchanged. A change that really needs no bump (comments only) is declared with a
`No-version-bump: <reason>` line in a commit message of the branch. The lines the branch adds get rules 2 and 6 too
(long dash, privacy scan), because a contributor's fork runs no hooks. Commit messages are not checked here: the
message rules are ours, a contributor's messages (and Co-Authored-By trailers) stay as they wrote them.
`--range BASE --no-version-rule` checks only the added lines: CI uses it for pull requests from forks, where the
maintainer adds the bump after review (see .github/workflows/ci.yml); the maintainer then runs the full `--range`.

There is deliberately no switch that turns everything off. `git commit --no-verify` does; do not use it (see
docs/DEVELOPMENT.md).
"""
from __future__ import annotations

import importlib.util
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

EM_DASH = "\u2014"

# Files that stay gitignored on purpose; `git add -f` is the only way they could reach a commit.
FORBIDDEN_NAMES = {"CLAUDE.md": "private working rules", ".env": "API keys"}
FORBIDDEN_PREFIXES = {
    "data/": "local data (raw e-mails)",
    "logs/": "local logs",
    "tests/private/": "real e-mails",
    "reports/": "private working notes",
}

# The PROGRAM (docs/DEVELOPMENT.md, versioning): a change here needs a version bump.
PROGRAM_PREFIXES = ("backend/", "frontend/")
PROGRAM_FILES = {
    "requirements.txt",
    "requirements.lock",
    "seisa.sh",
    "seisa-launcher.sh",
}
BASE_CANDIDATES = ("main", "origin/main", "github/main")

# Privacy scan. Strings that look like a real key, and a home directory path other than an obvious placeholder.
# A secret value: 20+ characters of a key alphabet that contain at least one digit. The digit rule keeps identifiers
# such as `settings.get_virustotal_api_key_value` out, and a real key (hex, base62, UUID) practically always has one.
_SECRET_VALUE = r"""["']?(?=[A-Za-z0-9_\-]*\d)[A-Za-z0-9_\-]{20,}"""
KEY_PATTERNS = (
    r"[0-9a-fA-F]{80}",                    # AbuseIPDB key
    r"sk-or-v1-[0-9a-fA-F]{20,}",          # OpenRouter key
    # Context patterns (a bare 64-hex string would also catch every sha256 in the tests): a value assigned to a name
    # that says key, token or secret. This covers .env lines (`VIRUSTOTAL_API_KEY=...`), JSON/YAML, and request headers
    # (`x-apikey:`, `API-Key:`, `X-OTX-API-KEY:`); a name followed by an empty value (.env.example) does not match.
    r"(?i)\b\w*(?:api[_-]?key|token|secret)\w*[\"']?[ \t]*[:=][ \t]*" + _SECRET_VALUE,
    r"(?i)\bkey[\"']?[ \t]*:[ \t]*" + _SECRET_VALUE,                  # a bare `Key: value` header
    r"(?i)\bbearer[ \t]+" + _SECRET_VALUE,                              # `Authorization: Bearer value`
)
HOME_PATH = re.compile(r"/(?:Users|home)/(?!(?:you|user|username|name|example|me)/)[A-Za-z0-9._-]+/")


class GitError(Exception):
    pass


def git(*args: str, check: bool = True) -> str:
    p = subprocess.run(
        ["git", "-c", "core.quotepath=off", *args], capture_output=True, text=True, encoding="utf-8", errors="replace"
    )
    if check and p.returncode != 0:
        raise GitError(f"git {' '.join(args)}: {p.stderr.strip()}")
    return p.stdout if p.returncode == 0 else ""


def show(spec: str) -> str | None:
    """Text of `<rev>:<path>` (rev empty = the index), None when it does not exist."""
    return show_many([spec])[spec]


def show_many(specs: list[str]) -> dict[str, str | None]:
    """Several `<rev>:<path>` blobs with ONE git process (starting a process is the slow part of a hook)."""
    p = subprocess.run(["git", "cat-file", "--batch"], input="".join(f"{s}\n" for s in specs).encode(), capture_output=True)
    out, pos, res = p.stdout, 0, {}
    for spec in specs:
        end = out.index(b"\n", pos)
        header = out[pos:end].split()
        pos = end + 1
        if len(header) == 3 and header[1] == b"blob":
            size = int(header[2])
            res[spec] = out[pos:pos + size].decode("utf-8", errors="replace")
            pos += size + 1
        else:
            res[spec] = None
    return res


def is_program_file(path: str) -> bool:
    return path.startswith(PROGRAM_PREFIXES) or path in PROGRAM_FILES


def forbidden_reason(path: str) -> str | None:
    p = Path(path)
    if p.name == ".gitkeep":
        return None
    if p.name in FORBIDDEN_NAMES:
        return FORBIDDEN_NAMES[p.name]
    for prefix, why in FORBIDDEN_PREFIXES.items():
        if path.startswith(prefix):
            return why
    return None


def twin_of(path: str, pairs) -> str | None:
    """The other language of a document, from DOC_PAIRS of scripts/check_docs.py (None for a file without a twin)."""
    for en, pl in pairs:
        if path == en:
            return pl
        if path == pl:
            return en
    return None


def parse_version(v: str) -> tuple[int, int, int] | None:
    m = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", v)
    return (int(m[1]), int(m[2]), int(m[3])) if m else None


def is_next_version(old: str, new: str) -> bool:
    """True when `new` is exactly one allowed step after `old`: Z+1, Y+1 with Z=0, or X+1 with Y=Z=0 (Z has no upper limit)."""
    o, n = parse_version(old), parse_version(new)
    if o is None or n is None:
        return False
    return n in {(o[0], o[1], o[2] + 1), (o[0], o[1] + 1, 0), (o[0] + 1, 0, 0)}


def added_lines(*revs: str) -> list[tuple[str, int, str]]:
    """(path, line number, text) of every line the staged change adds; with `revs` (BASE, HEAD) the lines a branch adds."""
    out: list[tuple[str, int, str]] = []
    path, lineno, in_header = "", 0, False
    for line in git("diff", *(revs or ("--cached",)), "-U0", "--no-color", "--no-ext-diff", "--diff-filter=ACMR").splitlines():
        if line.startswith("diff --git "):
            in_header = True
        elif in_header:
            if line.startswith("+++ "):
                path = line[6:] if line.startswith("+++ b/") else line[4:]
            elif line.startswith("@@"):
                in_header = False
        if in_header:
            continue
        if line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            lineno = int(m[1]) if m else 0
        elif line.startswith("+"):
            out.append((path, lineno, line[1:]))
            lineno += 1
    return out


def check_forbidden(staged: list[str]) -> list[str]:
    return [f"FORBIDDEN FILE: {f} ({why}); it is gitignored, never force-add it" for f in staged if (why := forbidden_reason(f))]


def check_long_dash(added: list[tuple[str, int, str]]) -> list[str]:
    return [
        f"LONG DASH (U+2014) at {path}:{n}, use '-'"
        for path, n, text in added
        if EM_DASH in text and not path.startswith("frontend/vendor/")
    ]


def check_pairs(staged: list[str], pairs) -> list[str]:
    if os.environ.get("SEISA_ONE_LANG") == "1":
        return []
    have = set(staged)
    problems = []
    for f in staged:
        twin = twin_of(f, pairs)
        if twin and twin not in have:
            problems.append(f"LANGUAGE PAIR: {f} is staged but {twin} is not (change both, or SEISA_ONE_LANG=1 for a one-language fix)")
    return problems


def load_privacy_markers() -> tuple[list[str], list[str], bool]:
    """(own names, allowed strings, whether the markers file exists). The file lives outside the repository."""
    path = Path(os.environ.get("SEISA_PRIVACY_MARKERS") or Path.home() / ".config" / "seisa" / "privacy-markers.txt")
    markers: list[str] = []
    allowed: list[str] = []
    if not path.is_file():
        return markers, allowed, False
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        (allowed if line.startswith("!") else markers).append(line.lstrip("!").strip())
    return markers, allowed, True


def privacy_problems(entries: list[tuple[str, str]], markers: list[str], allowed: list[str]) -> list[str]:
    """entries are (where, text). The matching value is deliberately not printed, only where it is."""
    problems = []
    for where, text in entries:
        for a in allowed:
            text = re.sub(re.escape(a), "", text, flags=re.IGNORECASE)
        if any(re.search(pattern, text) for pattern in KEY_PATTERNS):
            problems.append(f"PRIVACY: {where} looks like a real API key")
        if HOME_PATH.search(text):
            problems.append(f"PRIVACY: {where} contains a home directory path")
        low = text.lower()
        if any(m.lower() in low for m in markers):
            problems.append(f"PRIVACY: {where} contains one of your own host, domain or other private names (privacy markers file)")
    return problems


def added_line_problems(added: list[tuple[str, int, str]]) -> list[str]:
    """The rules for added lines, shared by one commit and `--range`: no long dash, the privacy scan."""
    markers, allowed, have_markers = load_privacy_markers()
    if not have_markers:
        print("note: no privacy markers file (see scripts/hooks/pre-commit), only the generic privacy checks ran")
    return check_long_dash(added) + privacy_problems(
        [(f"{p}:{n}", t) for p, n, t in added if not p.startswith("frontend/vendor/")], markers, allowed
    )


def check_commit_message(text: str) -> list[str]:
    body = "\n".join(line for line in text.splitlines() if not line.startswith("#"))  # '#' lines are git's own comments
    problems = []
    if EM_DASH in body:
        problems.append("LONG DASH (U+2014) in the commit message, use '-'")
    if re.search(r"^\s*co-authored-by:", body, re.IGNORECASE | re.MULTILINE):
        problems.append("CO-AUTHORED-BY: Claude is not a co-author in this project (docs/DEVELOPMENT.md); remove the trailer")
    if re.search(r"generated with .{0,40}claude", body, re.IGNORECASE):
        problems.append("ATTRIBUTION: remove the 'Generated with Claude Code' footer (docs/DEVELOPMENT.md)")
    markers, allowed, _ = load_privacy_markers()
    return problems + privacy_problems([("the commit message", body)], markers, allowed)


def release_notes_problems(version: str, changelog: str | None, html: str | None) -> list[str]:
    """A new version needs its CHANGELOG entry, dated like the release date shown in the Info tab."""
    m = re.search(rf"^## {re.escape(version)} - (\d{{4}}-\d{{2}}-\d{{2}})[ \t]*$", changelog or "", re.MULTILINE)
    if not m:
        return [f"CHANGELOG: no '## {version} - YYYY-MM-DD' entry for the new version (it goes in the same commit as the bump)"]
    d = re.search(r'<meta name="seisa-release-date" content="(\d{4}-\d{2}-\d{2})"', html or "")
    if not d or d[1] != m[1]:
        return [f'RELEASE DATE: CHANGELOG says {m[1]} for {version}, <meta name="seisa-release-date"> says {d[1] if d else "nothing"}']
    return []


def _load_script(root: Path, name: str, needs: tuple[str, ...]):
    """Imports scripts/<name> from `root` (an export of the index): the hook takes tables from the staged copy."""
    path = root / "scripts" / name
    spec = importlib.util.spec_from_file_location(f"seisa_{path.stem}", path)
    if spec is None or spec.loader is None:
        raise GitError(f"cannot load {path}")
    mod = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
    except (Exception, SystemExit) as e:  # a broken staged script must stop the commit with a message; SystemExit would end the hook with the module's exit code, maybe 0
        raise GitError(f"cannot import scripts/{name}: {e!r}") from e
    if not all(hasattr(mod, attr) for attr in needs):
        raise GitError(f"scripts/{name} lacks {'/'.join(needs)} (the hook reads them from it): stage the matching {name} too")
    return mod


def load_check_i18n(root: Path):
    return _load_script(root, "check_i18n.py", ("VERSION_PLACES", "read_versions"))


def load_check_docs(root: Path):
    return _load_script(root, "check_docs.py", ("DOC_PAIRS",))


def _is_ancestor(older: str, newer: str) -> bool:
    return subprocess.run(["git", "merge-base", "--is-ancestor", older, newer], capture_output=True).returncode == 0


def base_commit() -> str | None:
    """Where the branch left `main` (HEAD itself on main); None before the first commit.

    The newest of the merge-bases with main, origin/main and github/main: a local `main` that was not fast-forwarded
    after a merge on the server would otherwise make the version on `main` look older than it is. When the candidates
    diverged, the one with the longest history wins."""
    bases: list[str] = []
    for cand in BASE_CANDIDATES:
        mb = git("merge-base", "HEAD", cand, check=False).strip()
        if mb and mb not in bases:
            bases.append(mb)
    if not bases:
        return git("rev-parse", "--verify", "-q", "HEAD", check=False).strip() or None
    for mb in bases:
        if all(other == mb or _is_ancestor(other, mb) for other in bases):
            return mb
    return max(bases, key=lambda mb: int(git("rev-list", "--count", mb).strip() or 0))


def versions_at(ci, revs: list[str]) -> list[dict[str, str]]:
    """The version in each of the four places at each rev (empty rev = the index), all files read in one git call."""
    files = sorted({rel for _, rel, _ in ci.VERSION_PLACES})
    blobs = show_many([f"{rev}:{rel}" for rev in revs for rel in files])
    result = []
    for rev in revs:

        def read(rel: str, rev: str = rev) -> str:
            text = blobs[f"{rev}:{rel}"]
            if text is None:
                raise GitError(f"{rel} does not exist in {rev or 'the index'}")
            return text

        result.append(ci.read_versions(read))
    return result


def check_version_step(ci, base: str | None) -> list[str]:
    if base is None:
        return []
    new, old = versions_at(ci, ["", base])
    if len(set(new.values())) != 1 or len(set(old.values())) != 1:
        return []  # inconsistent places are reported by check_i18n; the step is meaningless then
    nv, ov = next(iter(new.values())), next(iter(old.values()))
    problems = []
    if nv != ov and not is_next_version(ov, nv):
        problems.append(f"VERSION STEP: {nv} after {ov} on main. Allowed: Z+1, or Y+1 with Z=0, or X+1 with Y=Z=0 (one bump per branch)")
    if nv != ov:
        notes = show_many([":CHANGELOG.md", ":frontend/index.html"])
        problems += release_notes_problems(nv, notes[":CHANGELOG.md"], notes[":frontend/index.html"])
    return problems


def run_check(root: Path, script: str, *args: str) -> list[str]:
    p = subprocess.run([sys.executable, str(root / "scripts" / script), *args], cwd=root, capture_output=True, text=True)
    if p.returncode == 0:
        return []
    label = Path(script).stem.upper()
    return [f"{label} failed:", *("    " + ln for ln in (p.stdout + p.stderr).splitlines() if ln.strip() and not ln.startswith("warning:"))]


def pre_commit() -> int:
    if not git("diff", "--cached", "--name-only", "-z"):  # nothing staged at all; a commit that only DELETES files is not empty
        return 0
    staged = [f for f in git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0") if f]
    added = added_lines()
    problems = check_forbidden(staged) + added_line_problems(added)
    with tempfile.TemporaryDirectory(prefix="seisa-precommit-") as tmp:
        git("checkout-index", "-a", f"--prefix={tmp}/")
        root = Path(tmp)
        # failing open here would let a commit that deletes a check switch the check off
        if (root / "scripts" / "check_docs.py").exists():
            problems += check_pairs(staged, load_check_docs(root).DOC_PAIRS)
            problems += run_check(root, "check_docs.py")
        else:
            problems.append("MISSING CHECK: scripts/check_docs.py is not in the index (the documentation and language-pair checks need it)")
        if (root / "scripts" / "check_i18n.py").exists():
            problems += run_check(root, "check_i18n.py", "--strict")
            problems += check_version_step(load_check_i18n(root), base_commit())
        else:
            problems.append("MISSING CHECK: scripts/check_i18n.py is not in the index (the i18n and version checks need it)")
    if problems:
        print("\n".join(problems))
        print("Commit aborted. Fix the problems; do not bypass the hook with --no-verify (docs/DEVELOPMENT.md).")
        return 1
    return 0


def _neutral_index_html(ci, text: str) -> str:
    """index.html with the version and the release date blanked out: a bump alone must not look like a program change."""
    for _label, rel, pattern in ci.VERSION_PLACES:
        if rel == "frontend/index.html":
            text = re.sub(pattern, lambda m: m.group(0).replace(m.group(1), "@V@"), text)
    return re.sub(r'(<meta name="seisa-release-date" content=")\d{4}-\d{2}-\d{2}', r"\1@D@", text)


def range_check(base_ref: str, version_rule: bool = True) -> int:
    base = git("merge-base", base_ref, "HEAD").strip()
    # A contributor's fork has no hooks, so the added-line rules are checked here for the whole branch as well.
    problems = added_line_problems(added_lines(base, "HEAD"))
    if not version_rule:
        if problems:
            print("\n".join(problems))
            return 1
        print("ok: added lines checked, version rule skipped (--no-version-rule)")
        return 0
    top = Path(git("rev-parse", "--show-toplevel").strip())
    ci = load_check_i18n(top)
    new, old = versions_at(ci, ["HEAD", base])
    if len(set(new.values())) != 1 or len(set(old.values())) != 1:
        print("\n".join([*problems, f"VERSION PLACES DISAGREE: at HEAD {new}, at the merge-base {old}"]))
        return 1
    nv, ov = next(iter(new.values())), next(iter(old.values()))
    changed = [f for f in git("diff", "--name-only", "--no-renames", base, "HEAD").split("\n") if f]
    program = []
    for f in changed:
        if not is_program_file(f):
            continue
        if f == "frontend/index.html":
            before, after = show(f"{base}:{f}"), show(f"HEAD:{f}")
            if before is not None and after is not None and _neutral_index_html(ci, before) == _neutral_index_html(ci, after):
                continue
        program.append(f)
    waiver = re.search(r"^No-version-bump:[ \t]*(\S.*)$", git("log", "--format=%B", f"{base}..HEAD"), re.M)
    if nv != ov:
        notes = show_many(["HEAD:CHANGELOG.md", "HEAD:frontend/index.html"])
        problems += release_notes_problems(nv, notes["HEAD:CHANGELOG.md"], notes["HEAD:frontend/index.html"])
        if not is_next_version(ov, nv):
            problems.append(f"VERSION STEP: {nv} after {ov}. Allowed: Z+1, or Y+1 with Z=0, or X+1 with Y=Z=0")
        if not program:
            problems.append(f"VERSION BUMPED WITHOUT A PROGRAM CHANGE: {ov} -> {nv}, but no program file changed (the version tracks the program)")
    elif program and not waiver:
        problems.append(
            f"PROGRAM CHANGED WITHOUT A VERSION BUMP (still {ov}): {', '.join(program[:5])}{' ...' if len(program) > 5 else ''}. "
            "Bump the version in the last commit of the branch, or put 'No-version-bump: <reason>' in a commit message if it really needs none"
        )
    if problems:
        print("\n".join(problems))
        return 1
    print(f"ok: version {ov} -> {nv}, program files changed: {len(program)}" + (f", waiver: {waiver[1]}" if waiver and nv == ov else ""))
    return 0


def main(argv: list[str]) -> int:
    try:
        msg_file = Path(argv[1]).resolve() if argv[:1] == ["--commit-msg"] and len(argv) == 2 else None
        os.chdir(git("rev-parse", "--show-toplevel").strip())
        if argv[:1] == ["--commit-msg"]:
            if msg_file is None:
                print("usage: pre-commit --commit-msg MESSAGE_FILE", file=sys.stderr)
                return 2
            problems = check_commit_message(msg_file.read_text(encoding="utf-8", errors="replace"))
            if problems:
                print("\n".join(problems))
                print("Commit aborted. Fix the message; do not bypass the hook with --no-verify (docs/DEVELOPMENT.md).")
                return 1
            return 0
        if argv[:1] == ["--range"]:
            if len(argv) not in (2, 3) or (len(argv) == 3 and argv[2] != "--no-version-rule"):
                print("usage: pre-commit [--range BASE [--no-version-rule]]", file=sys.stderr)
                return 2
            return range_check(argv[1], version_rule=len(argv) == 2)
        return pre_commit()
    except GitError as e:
        print(f"pre-commit could not run: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
