# Copy to .env and paste the real values. .env is gitignored.

URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
CLOUDFLARE_RADAR_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# Optional - enable the LLM layer (Email tab analysis and the eligibility assessment + draft
# comment of the AbuseIPDB tab). Without them the AbuseIPDB tab works in rule-based mode
# (fact extraction + writing the comment by hand) and the Email tab shows the deterministic analysis only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
