# Skopiuj do .env i wklej prawdziwe wartości. .env jest gitignored.

URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
CLOUDFLARE_RADAR_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# Opcjonalne — włączają warstwę LLM (ocena kwalifikowalności zgłoszeń + szkic
# opisu po angielsku) w zakładce Zgłoś. Bez nich ta zakładka działa w trybie
# regułowym (ekstrakcja faktów + ręczne pisanie opisu).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
